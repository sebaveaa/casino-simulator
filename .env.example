# Placeholder values that work with `docker compose up -d`. Copy to .env; never commit real secrets.

# PostgreSQL connection string
DATABASE_URL=postgres://casino:casino@localhost:5432/casino
# Redis connection string
REDIS_URL=redis://localhost:6379
# Key used to sign session tokens (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# development or production
APP_ENV=development
# Backend port
PORT=3000
# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# api or worker: the same image starts one or the other
PROCESS_ROLE=api
